# ═══ Environment configuration for Astrology AI ═══
# Copy to .env and fill values. NEVER commit real credentials.
# In production (APP_ENV=production) the app FAILS FAST if any of the
# REQUIRED variables are missing.

# ── REQUIRED in production ──────────────────────────────────────────────
APP_ENV=development
# Managed PostgreSQL connection string (Railway/Render/Neon/Supabase all work)
DATABASE_URL=
# Random secret >= 32 chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Public HTTPS origin of the deployment (no trailing slash)
BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── LLM providers (at least one recommended for chat) ───────────────────
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
AGENTROUTER_API_KEY=

# ── Optional / behavioural ──────────────────────────────────────────────
# Comma-separated origins allowed for cross-origin API access (leave empty for same-origin)
ALLOWED_ORIGINS=
# client_safe (default, guardrailed) or unconstrained (local grandmaster mode)
ASTRO_MODE=client_safe
LOG_LEVEL=INFO
# Uvicorn worker count in the container
WEB_CONCURRENCY=2

# ── Legacy/deprecated (unused by the app; kept to avoid confusion) ──────
# Pinecone is NOT used by this codebase — RAG runs on a local ChromaDB index.
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=

# ── Telegram data acquisition (offline corpus tooling only) ────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_GROUP_NAME=
